    "                    \"variable\": {\"type\": \"string\"},\n",
    "                },\n",
    "                \"required\": [\"gvkey\", \"feature_year\", \"variable\"],\n",
    "                \"additionalProperties\": False,\n",
    "            },\n",
    "        },\n",
    "    },\n",
    "    {\n",
    "        \"type\": \"function\",\n",
    "        \"function\": {\n",
    "            \"name\": \"get_peer_cohort\",\n",
    "            \"description\": \"Retrieve nearest firms in standardized financial space and their outcomes.\",\n",
    "            \"parameters\": {\n",
    "                \"type\": \"object\",\n",
    "                \"properties\": {\n",
    "                    \"gvkey\": {\"type\": \"string\"},\n",
    "                    \"feature_year\": {\"type\": \"integer\"},\n",
    "                    \"k\": {\n",
    "                        \"type\": \"integer\",\n",
    "                        \"minimum\": 1,\n",
    "                        \"maximum\": 100,\n",
    "                    },\n",
    "                },\n",
    "                \"required\": [\"gvkey\", \"feature_year\", \"k\"],\n",
    "                \"additionalProperties\": False,\n",
    "            },\n",
    "        },\n",
    "    },\n",
    "    {\n",
    "        \"type\": \"function\",\n",
    "        \"function\": {\n",
    "            \"name\": \"get_cohort_rate\",\n",
    "            \"description\": \"Retrieve the adverse-opinion rate for a named cohort slice.\",\n",
    "            \"parameters\": {\n",
    "                \"type\": \"object\",\n",
    "                \"properties\": {\n",
    "                    \"cohort_key\": {\"type\": \"string\"},\n",
    "                    \"cohort_value\": {\"type\": \"string\"},\n",
    "                    \"feature_year\": {\"type\": \"integer\"},\n",
    "                },\n",
    "                \"required\": [\n",
    "                    \"cohort_key\",\n",
    "                    \"cohort_value\",\n",
    "                    \"feature_year\",\n",
    "                ],\n",
    "                \"additionalProperties\": False,\n",
    "            },\n",
    "        },\n",
    "    },\n",
    "    {\n",
    "        \"type\": \"function\",\n",
    "        \"function\": {\n",
    "            \"name\": \"get_industry_context\",\n",
    "            \"description\": \"Retrieve adverse rate and typical ratios for an SIC industry group.\",\n",
    "            \"parameters\": {\n",
    "                \"type\": \"object\",\n",
    "                \"properties\": {\n",
    "                    \"sic\": {\"type\": \"integer\"},\n",
    "                    \"feature_year\": {\"type\": \"integer\"},\n",
    "                },\n",
    "                \"required\": [\"sic\", \"feature_year\"],\n",
    "                \"additionalProperties\": False,\n",
    "            },\n",
    "        },\n",
    "    },\n",
    "    {\n",
    "        \"type\": \"function\",\n",
    "        \"function\": {\n",
    "            \"name\": \"get_filing_excerpt\",\n",
    "            \"description\": \"Retrieve a cited passage from an available SEC filing.\",\n",
    "            \"parameters\": {\n",
    "                \"type\": \"object\",\n",
    "                \"properties\": {\n",
    "                    \"gvkey\": {\"type\": \"string\"},\n",
    "                    \"fyear\": {\"type\": \"integer\"},\n",
    "                    \"section\": {\n",
    "                        \"type\": \"string\",\n",
    "                        \"enum\": [\"Item 7\", \"Item 9A\", \"Item 15\"],\n",
    "                    },\n",
    "                },\n",
    "                \"required\": [\"gvkey\", \"fyear\", \"section\"],\n",
    "                \"additionalProperties\": False,\n",
    "            },\n",
    "        },\n",
    "    },\n",
    "]\n",
    "\n",
    "\n",
    "class LLMClient(Protocol):\n",
    "    def complete(\n",
    "        self,\n",
    "        messages: list[dict[str, Any]],\n",
    "        tools: list[dict[str, Any]],\n",
    "    ) -> dict[str, Any]:\n",
    "        \"\"\"Return a tool_call response or a final response.\"\"\"\n",
    "        ...\n",
    "\n",
    "\n",
    "class AgentError(RuntimeError):\n",
    "    pass\n",
    "\n",
    "\n",
    "@dataclass\n",
    "class AgentResult:\n",
    "    output: dict[str, Any]\n",
    "    trace: list[dict[str, Any]]\n",
    "    status: str\n",
    "    tool_calls_used: int\n",
    "    run_id: str\n",
    "\n",
    "\n",
    "def _jsonable(value: Any) -> Any:\n",
    "    try:\n",
    "        json.dumps(value)\n",
    "        return value\n",
    "    except (TypeError, ValueError):\n",
    "        return str(value)\n",
    "\n",
    "\n",
    "def _normalise_tool_result(\n",
    "    value: Any,\n",
    "    result_id: str,\n",
    ") -> dict[str, Any]:\n",
    "    if isinstance(value, Mapping):\n",
    "        result = dict(value)\n",
    "    else:\n",
    "        result = {\"data\": value}\n",
    "\n",
    "    result.setdefault(\"result_id\", result_id)\n",
    "    result.setdefault(\"source\", None)\n",
    "    return result\n",
    "\n",
    "\n",
    "def validate_output(\n",
    "    output: Any,\n",
    "    firm_id: str,\n",
    "    feature_year: int,\n",
    ") -> dict[str, Any]:\n",
    "    \"\"\"Validate the required output shape.\"\"\"\n",
    "\n",
    "    required = {\n",
    "        \"assessment\",\n",
    "        \"evidence\",\n",
    "        \"contradictory_evidence\",\n",
    "        \"uncertainty\",\n",
    "        \"recommended_checks\",\n",
    "    }\n",
    "\n",
    "    if isinstance(output, str):\n",
    "        try:\n",
    "            output = json.loads(output)\n",
    "        except json.JSONDecodeError:\n",
    "            output = None\n",
    "\n",
    "    if not isinstance(output, dict) or not required.issubset(output):\n",
    "        return {\n",
    "            \"assessment\": {\n",
    "                \"risk_level\": \"indeterminate\",\n",
    "                \"summary\": (\n",
    "                    \"The agent did not return a valid assessment \"\n",
    "                    \"matching the output contract.\"\n",
    "                ),\n",
    "                \"target\": (\n",
    "                    \"Adverse ICFR opinion (auopic=2) in the following \"\n",
    "                    \"fiscal year; not a finding of fraud.\"\n",
    "                ),\n",
    "                \"firm_id\": str(firm_id),\n",
    "                \"feature_year\": int(feature_year),\n",
    "                \"outcome_year\": int(feature_year) + 1,\n",
    "                \"probability\": None,\n",
    "                \"model_version\": None,\n",
    "                \"confidence\": \"low\",\n",
    "            },\n",
    "            \"evidence\": [],\n",
    "            \"contradictory_evidence\": [],\n",
    "            \"uncertainty\": [\n",
    "                \"The final response failed output-contract validation; \"\n",
    "                \"review the trace and retry.\"\n",
    "            ],\n",
    "            \"recommended_checks\": [\n",
    "                {\n",
    "                    \"check\": \"Review tool results and rerun the assessment.\",\n",
    "                    \"reason\": \"A valid structured conclusion was not produced.\",\n",
    "                }\n",
    "            ],\n",
    "        }\n",
    "\n",
    "    assessment = output.get(\"assessment\")\n",
    "    if not isinstance(assessment, dict):\n",
    "        assessment = {}\n",
    "\n",
    "    allowed_risk = {\"low\", \"moderate\", \"high\", \"indeterminate\"}\n",
    "    allowed_confidence = {\"low\", \"moderate\", \"high\"}\n",
    "\n",
    "    if assessment.get(\"risk_level\") not in allowed_risk:\n",
    "        assessment[\"risk_level\"] = \"indeterminate\"\n",
    "\n",
    "    if assessment.get(\"confidence\") not in allowed_confidence:\n",
    "        assessment[\"confidence\"] = \"low\"\n",
    "\n",
    "    assessment.setdefault(\"firm_id\", str(firm_id))\n",
    "    assessment.setdefault(\"feature_year\", int(feature_year))\n",
    "    assessment.setdefault(\"outcome_year\", int(feature_year) + 1)\n",
    "    assessment.setdefault(\"probability\", None)\n",
    "    assessment.setdefault(\"model_version\", None)\n",
    "    assessment.setdefault(\n",
    "        \"target\",\n",
    "        \"Adverse ICFR opinion (auopic=2) in the following fiscal year; \"\n",
    "        \"not a finding of fraud.\",\n",
    "    )\n",
    "    assessment.setdefault(\"summary\", \"Assessment summary unavailable.\")\n",
    "\n",
    "    output[\"assessment\"] = assessment\n",
    "\n",
    "    for key in (\n",
    "        \"evidence\",\n",
    "        \"contradictory_evidence\",\n",
    "        \"uncertainty\",\n",
    "        \"recommended_checks\",\n",
    "    ):\n",
    "        if not isinstance(output.get(key), list):\n",
    "            output[key] = []\n",
    "\n",
    "    return output\n",
    "\n",
    "\n",
    "def run_agent(\n",
    "    *,\n",
    "    firm_id: str,\n",
    "    feature_year: int,\n",
    "    user_question: str,\n",
    "    llm: LLMClient,\n",
    "    tools: Mapping[str, Callable[..., Any]],\n",
    "    max_tool_calls: int = 8,\n",
    "    tool_schemas: list[dict[str, Any]] | None = None,\n",
    ") -> AgentResult:\n",
    "    \"\"\"Run the agent with a maximum number of executed tool calls.\"\"\"\n",
    "\n",
    "    if max_tool_calls < 0:\n",
    "        raise ValueError(\"max_tool_calls must be >= 0\")\n",
    "\n",
    "    available = {\n",
    "        name: fn for name, fn in tools.items()\n",
    "        if name in TOOL_NAMES\n",
    "    }\n",
    "\n",
    "    if not available:\n",
    "        raise ValueError(\"No recognised agent tools were provided.\")\n",
    "\n",
    "    run_id = datetime.now(timezone.utc).strftime(\n",
    "        \"%Y%m%dT%H%M%S%fZ\"\n",
    "    )\n",
    "\n",
    "    schemas = (\n",
    "        tool_schemas\n",
    "        if tool_schemas is not None\n",
    "        else [\n",
    "            schema for schema in TOOL_SCHEMAS\n",
    "            if schema[\"function\"][\"name\"] in available\n",
    "        ]\n",
    "    )\n",
    "\n",
    "    messages: list[dict[str, Any]] = [\n",
    "        {\"role\": \"system\", \"content\": SYSTEM_PROMPT},\n",
    "        {\n",
    "            \"role\": \"user\",\n",
    "            \"content\": json.dumps(\n",
    "                {\n",
    "                    \"firm_id\": str(firm_id),\n",
    "                    \"feature_year\": int(feature_year),\n",
    "                    \"outcome_year\": int(feature_year) + 1,\n",
    "                    \"question\": user_question,\n",
    "                    \"required_output_keys\": [\n",
    "                        \"assessment\",\n",
    "                        \"evidence\",\n",
    "                        \"contradictory_evidence\",\n",
    "                        \"uncertainty\",\n",
    "                        \"recommended_checks\",\n",
    "                    ],\n",
    "                }\n",
    "            ),\n",
    "        },\n",
    "    ]\n",
    "\n",
    "    trace: list[dict[str, Any]] = []\n",
    "    calls = 0\n",
    "    status = \"completed\"\n",
    "\n",
    "    while True:\n",
    "        response = llm.complete(messages, schemas)\n",
    "\n",
    "        if not isinstance(response, dict):\n",
    "            response = {\"type\": \"final\", \"content\": response}\n",
    "\n",
    "        response_type = response.get(\"type\")\n",
    "\n",
    "        if response_type == \"final\":\n",
    "            output = validate_output(\n",
    "                response.get(\"content\"),\n",
    "                str(firm_id),\n",
    "                int(feature_year),\n",
    "            )\n",
    "            trace.append(\n",
    "                {\n",
    "                    \"event\": \"final_response\",\n",
    "                    \"run_id\": run_id,\n",
    "                    \"output\": _jsonable(output),\n",
    "                }\n",
    "            )\n",
    "            break\n",
    "\n",
    "        if response_type != \"tool_call\":\n",
    "            status = \"invalid_llm_response\"\n",
    "            output = validate_output(\n",
    "                None, str(firm_id), int(feature_year)\n",
    "            )\n",
    "            trace.append(\n",
    "                {\n",
    "                    \"event\": \"invalid_llm_response\",\n",
    "                    \"run_id\": run_id,\n",
    "                    \"response\": _jsonable(response),\n",
    "                }\n",
    "            )\n",
    "            break\n",
    "\n",
    "        name = response.get(\"name\")\n",
    "        arguments = response.get(\"arguments\", {})\n",
    "\n",
    "        if not isinstance(arguments, dict):\n",
    "            trace.append(\n",
    "                {\n",
    "                    \"event\": \"tool_rejected\",\n",
    "                    \"tool\": name,\n",
    "                    \"reason\": \"arguments_not_object\",\n",
    "                    \"arguments\": _jsonable(arguments),\n",
    "                }\n",
    "            )\n",
    "            messages.append(\n",
    "                {\n",
    "                    \"role\": \"assistant\",\n",
    "                    \"content\": (\n",
    "                        \"Tool call rejected: arguments must be a JSON \"\n",
    "                        \"object. Return a valid final assessment or \"\n",
    "                        \"a corrected tool call.\"\n",
    "                    ),\n",
    "                }\n",
    "            )\n",
    "            continue\n",
    "\n",
    "        if name not in available:\n",
    "            trace.append(\n",
    "                {\n",
    "                    \"event\": \"tool_rejected\",\n",
    "                    \"tool\": name,\n",
    "                    \"reason\": \"unknown_or_unavailable_tool\",\n",
    "                    \"arguments\": _jsonable(arguments),\n",
    "                }\n",
    "            )\n",
    "            messages.append(\n",
    "                {\n",
    "                    \"role\": \"assistant\",\n",
    "                    \"content\": (\n",
    "                        f\"Tool call rejected: {name!r} is not available. \"\n",
    "                        \"Use only available tool names.\"\n",
    "                    ),\n",
    "                }\n",
    "            )\n",
    "            continue\n",
    "\n",
    "        if calls >= max_tool_calls:\n",
    "            status = \"call_budget_exhausted\"\n",
    "            trace.append(\n",
    "                {\n",
    "                    \"event\": \"budget_exhausted\",\n",
    "                    \"max_tool_calls\": max_tool_calls,\n",
    "                    \"attempted_tool\": name,\n",
    "                    \"arguments\": _jsonable(arguments),\n",
    "                }\n",
    "            )\n",
    "            messages.append(\n",
    "                {\n",
    "                    \"role\": \"assistant\",\n",
    "                    \"content\": (\n",
    "                        f\"Tool-call budget of {max_tool_calls} has been \"\n",
    "                        \"exhausted. Do not call any more tools. Return \"\n",
    "                        \"the best supported assessment now, clearly \"\n",
    "                        \"stating any evidence gaps.\"\n",
    "                    ),\n",
    "                }\n",
    "            )\n",
    "\n",
    "            response = llm.complete(messages, [])\n",
    "            output = validate_output(\n",
    "                response.get(\"content\")\n",
    "                if isinstance(response, dict)\n",
    "                and response.get(\"type\") == \"final\"\n",
    "                else None,\n",
    "                str(firm_id),\n",
    "                int(feature_year),\n",
    "            )\n",
    "            trace.append(\n",
    "                {\n",
    "                    \"event\": \"final_response_after_budget\",\n",
    "                    \"run_id\": run_id,\n",
    "                    \"output\": _jsonable(output),\n",
    "                }\n",
    "            )\n",
    "            break\n",
    "\n",
    "        call_id = f\"tool_{calls + 1}\"\n",
    "        started = datetime.now(timezone.utc).isoformat()\n",
    "\n",
    "        event: dict[str, Any] = {\n",
    "            \"event\": \"tool_call\",\n",
    "            \"call_id\": call_id,\n",
    "            \"tool\": name,\n",
    "            \"arguments\": _jsonable(arguments),\n",
    "            \"started_at\": started,\n",
    "        }\n",
    "\n",
    "        try:\n",
    "            value = available[name](**arguments)\n",
    "            result = _normalise_tool_result(\n",
    "                value, f\"result_{calls + 1}\"\n",
    "            )\n",
    "            event.update(\n",
    "                {\"status\": \"ok\", \"result\": _jsonable(result)}\n",
    "            )\n",
    "            messages.append(\n",
    "                {\n",
    "                    \"role\": \"assistant\",\n",
    "                    \"content\": json.dumps(\n",
    "                        {\"tool_call\": name, \"arguments\": arguments}\n",
    "                    ),\n",
    "                }\n",
    "            )\n",
    "            messages.append(\n",
    "                {\n",
    "                    \"role\": \"tool\",\n",
    "                    \"name\": name,\n",
    "                    \"content\": json.dumps(result, default=str),\n",
    "                }\n",
    "            )\n",
    "\n",
    "        except Exception as exc:\n",
    "            result = {\n",
    "                \"result_id\": f\"result_{calls + 1}\",\n",
    "                \"error\": type(exc).__name__,\n",
    "                \"message\": str(exc),\n",
    "                \"source\": None,\n",
    "            }\n",
    "            event.update({\"status\": \"error\", \"error\": result})\n",
    "            messages.append(\n",
    "                {\n",
    "                    \"role\": \"assistant\",\n",
    "                    \"content\": json.dumps(\n",
    "                        {\"tool_call\": name, \"arguments\": arguments}\n",
    "                    ),\n",
    "                }\n",
    "            )\n",
    "            messages.append(\n",
    "                {\n",
    "                    \"role\": \"tool\",\n",
    "                    \"name\": name,\n",
    "                    \"content\": json.dumps(result),\n",
    "                }\n",
    "            )\n",
    "\n",
    "        event[\"finished_at\"] = datetime.now(timezone.utc).isoformat()\n",
    "        trace.append(event)\n",
    "        calls += 1\n",
    "\n",
    "    return AgentResult(\n",
    "        output=output,\n",
    "        trace=trace,\n",
    "        status=status,\n",
    "        tool_calls_used=calls,\n",
    "        run_id=run_id,\n",
    "    )\n",
    "\n",
    "\n",
    "def verify_evidence_links(\n",
    "    output: dict[str, Any],\n",
    "    trace: list[dict[str, Any]],\n",
    ") -> dict[str, Any]:\n",
    "    \"\"\"Check that cited evidence IDs exist in successful tool results.\"\"\"\n",
    "\n",
    "    known_ids = {\n",
    "        event.get(\"result\", {}).get(\"result_id\")\n",
    "        for event in trace\n",
    "        if event.get(\"event\") == \"tool_call\"\n",
    "        and event.get(\"status\") == \"ok\"\n",
    "    }\n",
    "\n",
    "    report = {\n",
    "        \"verified_items\": 0,\n",
    "        \"blocked_items\": 0,\n",
    "        \"issues\": [],\n",
    "    }\n",
    "\n",
    "    for section in (\"evidence\", \"contradictory_evidence\"):\n",
    "        kept = []\n",
    "\n",
    "        for item in output.get(section, []):\n",
    "            refs = (\n",
    "                item.get(\"tool_result_ids\", [])\n",
    "                if isinstance(item, dict)\n",
    "                else []\n",
    "            )\n",
    "\n",
    "            if refs and all(ref in known_ids for ref in refs):\n",
    "                kept.append(item)\n",
    "                report[\"verified_items\"] += 1\n",
    "            else:\n",
    "                report[\"blocked_items\"] += 1\n",
    "                report[\"issues\"].append(\n",
    "                    {\n",
    "                        \"section\": section,\n",
    "                        \"item\": item,\n",
    "                        \"reason\": \"Missing or unknown tool_result_ids\",\n",
    "                    }\n",
    "                )\n",
    "\n",
    "        output[section] = kept\n",
    "\n",
    "    return report"
   ]
  },
