    "# Draw a flowchart with matplotlib.\n",
    "import matplotlib.pyplot as plt\n",
    "from matplotlib.patches import FancyBboxPatch, FancyArrowPatch\n",
    "\n",
    "def draw_flowchart(nodes, edges, title, figsize=(12, 6)):\n",
    "    fig, ax = plt.subplots(figsize=figsize)\n",
    "    ax.set_xlim(0, 12)\n",
    "    ax.set_ylim(0, 8)\n",
    "    ax.axis(\"off\")\n",
    "    positions = {n[\"id\"]: (n[\"x\"], n[\"y\"]) for n in nodes}\n",
    "    for n in nodes:\n",
    "        x, y = positions[n[\"id\"]]\n",
    "        box = FancyBboxPatch((x, y), n.get(\"w\", 2.2), n.get(\"h\", 0.8),\n",
    "                             boxstyle=\"round,pad=0.08\", fill=False, linewidth=1.5)\n",
    "        ax.add_patch(box)\n",
    "        ax.text(x + n.get(\"w\", 2.2)/2, y + n.get(\"h\", 0.8)/2, n[\"label\"],\n",
    "                ha=\"center\", va=\"center\", fontsize=9, wrap=True)\n",
    "    for start, end, label in edges:\n",
    "        x1, y1 = positions[start]\n",
    "        x2, y2 = positions[end]\n",
    "        w1 = next(n.get(\"w\", 2.2) for n in nodes if n[\"id\"] == start)\n",
    "        h1 = next(n.get(\"h\", 0.8) for n in nodes if n[\"id\"] == start)\n",
    "        w2 = next(n.get(\"w\", 2.2) for n in nodes if n[\"id\"] == end)\n",
    "        p1 = (x1 + w1/2, y1 + h1/2)\n",
    "        p2 = (x2 + w2/2, y2 + 0.4)\n",
    "        arrow = FancyArrowPatch(p1, p2, arrowstyle=\"-|>\", mutation_scale=12,\n",
    "                                linewidth=1.2, connectionstyle=\"arc3,rad=0.0\")\n",
    "        ax.add_patch(arrow)\n",
    "        if label:\n",
    "            ax.text((p1[0]+p2[0])/2, (p1[1]+p2[1])/2 + 0.12, label,\n",
    "                    fontsize=8, ha=\"center\", va=\"center\")\n",
    "    ax.set_title(title, fontsize=14, pad=15)\n",
    "    plt.show()\n",
    "\n",
    "agent_nodes = [\n",
    "    {\"id\":\"task\",\"x\":0.5,\"y\":6.2,\"label\":\"User task + system prompt\",\"w\":2.3},\n",
