    "    {\"id\":\"final\",\"x\":9.3,\"y\":3.9,\"label\":\"Validate and return structured output\",\"w\":2.4},\n",
    "]\n",
    "agent_edges = [\n",
    "    (\"task\",\"model\",\"\"),\n",
