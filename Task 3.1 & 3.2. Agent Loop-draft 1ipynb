    "\"\"\"Runs the agent loop and manages tool calls and responses.\"\"\"\n",
    "\n",
    "from __future__ import annotations\n",
    "\n",
    "from dataclasses import dataclass\n",
    "from datetime import datetime, timezone\n",
    "from typing import Any, Callable, Mapping, Protocol\n",
    "import json\n",
    "\n",
    "\n",
    "TOOL_NAMES = (\n",
    "    \"get_firm_history\",\n",
    "    \"get_control_history\",\n",
    "    \"score_firm\",\n",
    "    \"get_percentile\",\n",
    "    \"get_deviation\",\n",
    "    \"get_peer_cohort\",\n",
    "    \"get_cohort_rate\",\n",
    "    \"get_industry_context\",\n",
    "    \"get_filing_excerpt\",\n",
    ")\n",
    "\n",
    "\n",
    "SYSTEM_PROMPT = \"\"\"\n",
    "Your task is to investigate a firm's risk of receiving an adverse auditor opinion.\n",
    "\n",
    "Use the available tools to investigate the firm and collect supporting evidence.\n",
    "Every factual claim must be supported by tool results.\n",
    "Do not invent facts or evidence.\n",
    "Submit the draft findings to the verifier before displaying the final answer.\n",
    "\n",
    "Ground rules:\n",
    "1. The model target is an adverse ICFR opinion (auopic=2), which indicates a\n",
    "   material weakness in internal controls. It does NOT by itself prove fraud or\n",
    "   that a financial misstatement occurred.\n",
    "2. Use only the supplied tool results as factual evidence about the firm. Do not\n",
    "   invent figures, dates, peer statistics, filing passages, or citations.\n",
    "3. Treat auopic=0 or missing assessment as \"not assessed/unknown\", never as\n",
    "   \"effective\". Distinguish current-year evidence from the next-year forecast.\n",
    "4. Use tools deliberately. Start with the risk score and firm/control history;\n",
    "   query percentiles, deviations, peers, industry context, or filing excerpts\n",
    "   when they help test or contextualize the initial view.\n",
    "5. Look for contradictory evidence as well as supporting evidence. Do not force\n",
    "   all signals to agree. Explain what each signal does and does not establish.\n",
    "6. If information is unavailable, contradictory, stale, or based on a stub, say\n",
    "   so explicitly. Do not imply a filing was reviewed unless a filing tool result\n",
    "   supplies a passage and citation.\n",
    "7. Do not expose chain-of-thought. Provide concise conclusions and evidence-based\n",
    "   reasons only.\n",
    "8. Return exactly one JSON object conforming to the output contract. Do not wrap\n",
    "   it in Markdown fences. Every evidence item must cite one or more tool-result\n",
    "   IDs from this run. If evidence is insufficient, lower confidence and recommend\n",
    "   specific checks.\n",
    "\n",
    "Output contract keys:\n",
    "assessment, evidence, contradictory_evidence, uncertainty, recommended_checks.\n",
    "\n",
    "assessment is an object with risk_level, summary, target, firm_id, feature_year,\n",
    "outcome_year, probability, model_version, and confidence.\n",
    "\n",
    "evidence and contradictory_evidence are arrays of objects with claim,\n",
    "tool_result_ids, and interpretation.\n",
    "\n",
    "uncertainty is an array of strings.\n",
    "recommended_checks is an array of objects with check and reason.\n",
    "\n",
    "risk_level must be one of low, moderate, high, or indeterminate.\n",
    "confidence must be one of low, moderate, or high.\n",
    "Use null when a value is not available.\n",
    "\"\"\"\n",
    "\n",
    "\n",
    "# Interface-level tool schemas. Confirm parameter names against src/tools.py\n",
    "# before connecting the real tools.\n",
    "TOOL_SCHEMAS: list[dict[str, Any]] = [\n",
    "    {\n",
    "        \"type\": \"function\",\n",
    "        \"function\": {\n",
    "            \"name\": \"get_firm_history\",\n",
    "            \"description\": \"Retrieve a firm's historical financial ratios and control opinions.\",\n",
    "            \"parameters\": {\n",
    "                \"type\": \"object\",\n",
    "                \"properties\": {\n",
    "                    \"gvkey\": {\"type\": \"string\"},\n",
    "                    \"through_fyear\": {\"type\": \"integer\"},\n",
    "                },\n",
    "                \"required\": [\"gvkey\", \"through_fyear\"],\n",
    "                \"additionalProperties\": False,\n",
    "            },\n",
    "        },\n",
    "    },\n",
    "    {\n",
    "        \"type\": \"function\",\n",
    "        \"function\": {\n",
    "            \"name\": \"get_control_history\",\n",
    "            \"description\": \"Retrieve years with adverse internal-control opinions for a firm.\",\n",
    "            \"parameters\": {\n",
    "                \"type\": \"object\",\n",
    "                \"properties\": {\n",
    "                    \"gvkey\": {\"type\": \"string\"},\n",
    "                    \"through_fyear\": {\"type\": \"integer\"},\n",
    "                },\n",
    "                \"required\": [\"gvkey\", \"through_fyear\"],\n",
    "                \"additionalProperties\": False,\n",
    "            },\n",
    "        },\n",
    "    },\n",
    "    {\n",
    "        \"type\": \"function\",\n",
    "        \"function\": {\n",
    "            \"name\": \"score_firm\",\n",
    "            \"description\": \"Return the frozen model's probability of an adverse opinion in year t+1.\",\n",
    "            \"parameters\": {\n",
    "                \"type\": \"object\",\n",
    "                \"properties\": {\n",
    "                    \"gvkey\": {\"type\": \"string\"},\n",
    "                    \"feature_year\": {\"type\": \"integer\"},\n",
    "                },\n",
    "                \"required\": [\"gvkey\", \"feature_year\"],\n",
    "                \"additionalProperties\": False,\n",
    "            },\n",
    "        },\n",
    "    },\n",
    "    {\n",
    "        \"type\": \"function\",\n",
    "        \"function\": {\n",
    "            \"name\": \"get_percentile\",\n",
    "            \"description\": \"Locate a firm's ratio within the distribution for its fiscal year.\",\n",
    "            \"parameters\": {\n",
    "                \"type\": \"object\",\n",
    "                \"properties\": {\n",
    "                    \"gvkey\": {\"type\": \"string\"},\n",
    "                    \"feature_year\": {\"type\": \"integer\"},\n",
    "                    \"variable\": {\"type\": \"string\"},\n",
